{
  "name": "Hue-App-Controller",
  "productName": "Open Hue Controller",
  "version": "1.0.2",
  "description": "The Open Hue Controller enables you to control all your Philips Hue lighting from the app.",
  "main": "src/index.js",
  "author": "Jakob Lykke",
  "license": "MIT",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "start": "node scripts/copy-web.js && electron .",
    "dist": "node scripts/copy-web.js && electron-builder --win"
  },
  "build": {
    "appId": "com.electron.hue-app-controller",
    "productName": "Open Hue Controller",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/icons/512x512.png"
    },
    "nsis": {
      "guid": "148df3fa-1076-550e-a134-9db94946afb2",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version} Windows.${ext}"
    }
  },
  "devDependencies": {
    "electron": "17.1.2",
    "electron-builder": "26.15.3"
  }
}
